# EditorConfig helps maintain consistent coding styles across editors
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Python files
[*.py]
indent_size = 4

# Shell scripts
[*.sh]
end_of_line = lf
indent_size = 2

# Markdown documentation
[*.md]
trim_trailing_whitespace = false

# YAML configuration
[*.{yml,yaml}]
indent_size = 2

# JSON configuration
[*.json]
indent_size = 2

# Makefile
[Makefile]
indent_style = tab
