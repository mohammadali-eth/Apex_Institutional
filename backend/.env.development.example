# Development environment profile
APP_NAME=QPMS Backend (Dev)
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true
API_V1_PREFIX=/api/v1

HOST=127.0.0.1
PORT=8000

SECRET_KEY=dev-local-secret-key-qpms-foundation-testing-only-32chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/qpms_dev
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LOG_LEVEL=DEBUG
LOG_FORMAT=text
