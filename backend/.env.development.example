# ==============================================================================
# Development Environment Profile Template
# ==============================================================================
APP_NAME=QPMS Enterprise (Dev)
APP_ENV=development
APP_VERSION=0.1.0
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
DEBUG=true
API_V1_PREFIX=/api/v1

HOST=127.0.0.1
PORT=8000

SECRET_KEY=dev-local-secret-key-qpms-foundation-testing-only-32chars
AUTH_SESSION_COOKIE_NAME=qpms_session
AUTH_SESSION_IDLE_TIMEOUT_MINUTES=60
AUTH_SESSION_ABSOLUTE_TIMEOUT_HOURS=24
AUTH_SESSION_COOKIE_SECURE=false
AUTH_SESSION_COOKIE_SAMESITE=lax
AUTH_CSRF_COOKIE_NAME=qpms_csrf
AUTH_CSRF_HEADER_NAME=X-CSRF-Token

AUTH_ARGON2_TIME_COST=3
AUTH_ARGON2_MEMORY_COST=65536
AUTH_ARGON2_PARALLELISM=4

AUTH_EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
AUTH_PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
AUTH_RATE_LIMIT_LOGIN_ATTEMPTS=5
AUTH_RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
AUTH_ACCOUNT_LOCKOUT_DURATION_MINUTES=15

STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=data/uploads
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.png,.jpg,.jpeg

EMAIL_DELIVERY_PROVIDER=console
EMAIL_DELIVERY_FILE_PATH=data/emails.log
EMAIL_FROM_ADDRESS=no-reply@apex.edu
EMAIL_FROM_NAME=Apex QPMS

DEFAULT_LANGUAGE=English
PAPER_GENERATION_TIMEOUT_SECONDS=30
MAX_PAPER_MARKS=100

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/qpms_dev
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/qpms_test
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LOG_LEVEL=DEBUG
LOG_FORMAT=text
AUDIT_LOG_RETENTION_DAYS=365
