# Test environment profile (isolated test DB)
APP_NAME=QPMS Backend (Test)
APP_ENV=test
APP_VERSION=0.1.0
DEBUG=false
API_V1_PREFIX=/api/v1

HOST=127.0.0.1
PORT=8001

SECRET_KEY=test-environment-secret-key-qpms-32chars-minimum-token
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=1

# Isolated database strictly dedicated for automated test execution
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/qpms_test
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/qpms_test
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=15
DB_POOL_RECYCLE=600
DB_ECHO=false

CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=WARNING
LOG_FORMAT=text
