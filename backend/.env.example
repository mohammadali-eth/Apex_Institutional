# ==============================================================================
# Question Paper Management System (QPMS) — Backend Environment Configuration
# Template file: Copy to .env for local usage. NEVER commit real secrets to Git.
#
# Quick setup:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# A. Application Configuration
# ------------------------------------------------------------------------------
APP_NAME=QPMS Enterprise
APP_ENV=development
APP_VERSION=0.1.0
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
DEBUG=false
API_V1_PREFIX=/api/v1

# Server Bindings
HOST=127.0.0.1
PORT=8000

# ------------------------------------------------------------------------------
# B. Database Configuration (PostgreSQL + asyncpg)
# ------------------------------------------------------------------------------
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/qpms_dev
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/qpms_test
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# ------------------------------------------------------------------------------
# C. Authentication and Session Security
# ------------------------------------------------------------------------------
# In production, SECRET_KEY must be a cryptographically secure string (min 32 chars):
# Generate with: openssl rand -hex 32
SECRET_KEY=dev-insecure-secret-key-change-in-production-min-32-chars
AUTH_SESSION_COOKIE_NAME=qpms_session
AUTH_SESSION_IDLE_TIMEOUT_MINUTES=60
AUTH_SESSION_ABSOLUTE_TIMEOUT_HOURS=24
AUTH_SESSION_COOKIE_SECURE=false
AUTH_SESSION_COOKIE_SAMESITE=lax
AUTH_CSRF_COOKIE_NAME=qpms_csrf
AUTH_CSRF_HEADER_NAME=X-CSRF-Token

# Argon2id Cryptographic Parameters (RFC 9106)
AUTH_ARGON2_TIME_COST=3
AUTH_ARGON2_MEMORY_COST=65536
AUTH_ARGON2_PARALLELISM=4

# Token Lifecycles & Rate Limiting
AUTH_EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
AUTH_PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
AUTH_RATE_LIMIT_LOGIN_ATTEMPTS=5
AUTH_RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
AUTH_ACCOUNT_LOCKOUT_DURATION_MINUTES=15

# ------------------------------------------------------------------------------
# D. Initial Administrator Setup (CLI Bootstrap)
# ------------------------------------------------------------------------------
# Run initial provisioning via CLI:
#   python -m app.commands.bootstrap --role university_admin --username admin --password admin123
# Note: In production, default credentials ('admin123') are strictly rejected.

# ------------------------------------------------------------------------------
# E. File Uploads and Document Storage
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=data/uploads
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.png,.jpg,.jpeg

# ------------------------------------------------------------------------------
# F. Email and Notifications
# ------------------------------------------------------------------------------
# Providers: 'console' (prints to terminal), 'file' (appends to log), 'smtp', 'disabled'
EMAIL_DELIVERY_PROVIDER=console
EMAIL_DELIVERY_FILE_PATH=data/emails.log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=no-reply@apex.edu
EMAIL_FROM_NAME=Apex QPMS

# ------------------------------------------------------------------------------
# G. Question Paper System Configuration
# ------------------------------------------------------------------------------
DEFAULT_LANGUAGE=English
PAPER_GENERATION_TIMEOUT_SECONDS=30
MAX_PAPER_MARKS=100

# ------------------------------------------------------------------------------
# H. Security and Logging
# ------------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LOG_LEVEL=INFO
LOG_FORMAT=text
AUDIT_LOG_RETENTION_DAYS=365
