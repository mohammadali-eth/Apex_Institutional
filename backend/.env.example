# ==============================================================================
# Question Paper Management System (QPMS) - Backend Environment Configuration
# Template file: Copy to .env for local usage. NEVER commit .env into source control.
# ==============================================================================

# Application Environment (development | test | production)
APP_NAME=QPMS Backend
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=false
API_V1_PREFIX=/api/v1

# Server Binding
HOST=127.0.0.1
PORT=8000

# Security (Future Authentication & Encryption)
# In production, SECRET_KEY must be a cryptographically secure random string.
SECRET_KEY=dev-insecure-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL with asyncpg driver)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/qpms_dev
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Test Database Connection (Used exclusively during test runs)
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/qpms_test

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
