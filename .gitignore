# ==============================================================================
# Root Monorepo Git Ignore Rules
# ==============================================================================

# Node / Frontend Dependencies
node_modules/
.pnp/
.pnp.js

# Frontend Build Outputs & Caches
dist/
build/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# Python Bytecode & Cache Directories
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.installed.cfg
*.egg

# Python Virtual Environments
.venv/
venv/
env/
ENV/

# Python Quality & Testing Tools Cache
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

# Local Environment & Secrets (Never commit credentials)
.env
.env.local
.env.*.local
*.pem
*.key
*.cert

# Allow explicit example configuration templates to be tracked
!.env.example
!.env.*.example
!frontend/.env.example
!backend/.env.example
!backend/.env.*.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Database & Runtime Artifacts
*.sqlite3
*.db
uploads/
data/
backend/data/

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini

# IDE & Editor Directories
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
