datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==============================================================================
// 1. ENUMS (Aligned with System Domain & Authentication)
// ==============================================================================

enum UserStatus {
  pending_verification
  active
  locked
  disabled
}

enum OrganizationStatus {
  active
  suspended
  inactive
}

enum InvitationStatus {
  INVITED
  PENDING_ACTIVATION
  ACTIVE
  EXPIRED
  REVOKED
}

enum QuestionType {
  MCQ
  SHORT_ANSWER
  LONG_ANSWER
  ESSAY
  NUMERICAL
  DESCRIPTIVE
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum BloomLevel {
  REMEMBER
  UNDERSTAND
  APPLY
  ANALYZE
  EVALUATE
  CREATE
}

enum QuestionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum PaperStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  QUALITY_REVIEW
  QUALITY_APPROVED
  PENDING_FINAL_APPROVAL
  APPROVED
  FINALIZED
  PUBLISHED
  ARCHIVED
}

enum ExamStatus {
  PLANNED
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

// ==============================================================================
// 2. PLATFORM & INSTITUTION (Multi-tenant Hierarchy)
// ==============================================================================

model University {
  id                  String               @id @default(uuid()) @db.Uuid
  code                String               @unique @db.VarChar(64)
  name                String               @db.VarChar(255)
  type                String               @default("State University") @db.VarChar(64)
  status              OrganizationStatus   @default(active)
  region              String?              @db.VarChar(128)
  address             String?              @db.VarChar(512)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  institutions        Institution[]
  roleAssignments     UserRoleAssignment[]
  staffInvitations    StaffInvitation[]
  domainRoleMappings  DomainRoleMapping[]
  questions           Question[]
  questionPapers      QuestionPaper[]
  exams               Exam[]

  @@map("universities")
}

model Institution {
  id                  String               @id @default(uuid()) @db.Uuid
  universityId        String               @map("university_id") @db.Uuid
  code                String               @unique @db.VarChar(64)
  name                String               @db.VarChar(255)
  type                String               @default("College") @db.VarChar(64)
  status              OrganizationStatus   @default(active)
  address             String?              @db.VarChar(512)
  contactEmail        String?              @map("contact_email") @db.VarChar(255)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  university          University           @relation(fields: [universityId], references: [id], onDelete: Cascade)
  departments         Department[]
  roleAssignments     UserRoleAssignment[]
  staffInvitations    StaffInvitation[]
  domainRoleMappings  DomainRoleMapping[]
  questions           Question[]
  questionPapers      QuestionPaper[]
  exams               Exam[]

  @@index([universityId])
  @@index([status])
  @@map("institutions")
}

model Department {
  id                  String               @id @default(uuid()) @db.Uuid
  institutionId       String               @map("institution_id") @db.Uuid
  code                String               @db.VarChar(64)
  name                String               @db.VarChar(255)
  hodName             String?              @map("hod_name") @db.VarChar(255)
  status              OrganizationStatus   @default(active)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  institution         Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  programs            Program[]
  subjects            Subject[]
  roleAssignments     UserRoleAssignment[]
  staffInvitations    StaffInvitation[]
  domainRoleMappings  DomainRoleMapping[]
  questions           Question[]
  questionPapers      QuestionPaper[]
  exams               Exam[]

  @@unique([institutionId, code], name: "uq_department_inst_code")
  @@index([institutionId])
  @@index([status])
  @@map("departments")
}

model Program {
  id                  String               @id @default(uuid()) @db.Uuid
  departmentId        String               @map("department_id") @db.Uuid
  code                String               @db.VarChar(64)
  name                String               @db.VarChar(255)
  durationYears       Int                  @default(4) @map("duration_years")
  status              OrganizationStatus   @default(active)
  tagline             String?              @db.VarChar(255)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  department          Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  semesters           Semester[]
  subjects            Subject[]
  questionPapers      QuestionPaper[]

  @@unique([departmentId, code], name: "uq_program_dept_code")
  @@index([departmentId])
  @@map("academic_programs")
}

model Semester {
  id                  String               @id @default(uuid()) @db.Uuid
  programId           String               @map("program_id") @db.Uuid
  number              Int
  label               String               @db.VarChar(64)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  program             Program              @relation(fields: [programId], references: [id], onDelete: Cascade)
  subjects            Subject[]
  questionPapers      QuestionPaper[]

  @@unique([programId, number], name: "uq_semester_program_number")
  @@index([programId])
  @@map("academic_semesters")
}

// ==============================================================================
// 3. USERS, ROLES, PERMISSIONS & AUTHENTICATION
// ==============================================================================

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique @db.VarChar(255)
  username            String?              @unique @db.VarChar(128)
  fullName            String?              @map("full_name") @db.VarChar(255)
  passwordHash        String               @map("password_hash") @db.VarChar(255)
  status              UserStatus           @default(pending_verification)
  emailVerifiedAt     DateTime?            @map("email_verified_at") @db.Timestamptz
  lastLoginAt         DateTime?            @map("last_login_at") @db.Timestamptz
  passwordChangedAt   DateTime?            @map("password_changed_at") @db.Timestamptz
  disabledAt          DateTime?            @map("disabled_at") @db.Timestamptz
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  sessions            UserSession[]
  emailTokens         EmailVerificationToken[]
  resetTokens         PasswordResetToken[]
  roleAssignments     UserRoleAssignment[] @relation("UserAssignedRoles")
  assignedByMe        UserRoleAssignment[] @relation("AssignedByRoles")
  staffInvitationsSent StaffInvitation[]   @relation("StaffInvitedBy")
  questionsCreated    Question[]           @relation("QuestionCreatedBy")
  questionsApproved   Question[]           @relation("QuestionApprovedBy")
  questionVersions    QuestionVersion[]    @relation("QuestionVersionEditedBy")
  papersCreated       QuestionPaper[]      @relation("PaperCreatedBy")
  papersReviewed      QuestionPaper[]      @relation("PaperReviewedBy")
  papersQualityReviewed QuestionPaper[]    @relation("PaperQualityReviewedBy")
  paperWorkflowEvents PaperWorkflowTimeline[] @relation("PaperTimelineActor")
  auditEvents         AuthenticationAuditEvent[]
  systemAuditLogs     SystemAuditLog[]

  @@index([email])
  @@index([status])
  @@map("users")
}

model Role {
  id                  String               @id @default(uuid()) @db.Uuid
  code                String               @unique @db.VarChar(64)
  name                String               @db.VarChar(128)
  description         String?              @db.VarChar(512)
  isSystem            Boolean              @default(false) @map("is_system")
  isActive            Boolean              @default(true) @map("is_active")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  rolePermissions     RolePermission[]
  roleAssignments     UserRoleAssignment[]
  staffInvitations    StaffInvitation[]
  domainRoleMappings  DomainRoleMapping[]

  @@index([code])
  @@index([isActive])
  @@map("roles")
}

model Permission {
  id                  String               @id @default(uuid()) @db.Uuid
  code                String               @unique @db.VarChar(64)
  name                String               @db.VarChar(128)
  module              String               @db.VarChar(64)
  description         String?              @db.VarChar(512)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  rolePermissions     RolePermission[]

  @@index([code])
  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id                  String               @id @default(uuid()) @db.Uuid
  roleId              String               @map("role_id") @db.Uuid
  permissionId        String               @map("permission_id") @db.Uuid
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  role                Role                 @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission          Permission           @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], name: "uq_role_permission")
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id                  String               @id @default(uuid()) @db.Uuid
  userId              String               @map("user_id") @db.Uuid
  roleId              String               @map("role_id") @db.Uuid
  universityId        String?              @map("university_id") @db.Uuid
  institutionId       String?              @map("institution_id") @db.Uuid
  departmentId        String?              @map("department_id") @db.Uuid
  isActive            Boolean              @default(true) @map("is_active")
  assignedByUserId    String?              @map("assigned_by_user_id") @db.Uuid
  revokedAt           DateTime?            @map("revoked_at") @db.Timestamptz
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user                User                 @relation("UserAssignedRoles", fields: [userId], references: [id], onDelete: Cascade)
  role                Role                 @relation(fields: [roleId], references: [id], onDelete: Cascade)
  university          University?          @relation(fields: [universityId], references: [id], onDelete: Cascade)
  institution         Institution?         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  department          Department?          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  assignedByUser      User?                @relation("AssignedByRoles", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([roleId])
  @@index([universityId])
  @@index([institutionId])
  @@index([departmentId])
  @@index([isActive])
  @@index([userId, roleId, universityId, institutionId, departmentId, isActive], name: "ix_active_role_scope")
  @@map("user_role_assignments")
}

model UserSession {
  id                  String               @id @default(uuid()) @db.Uuid
  userId              String               @map("user_id") @db.Uuid
  tokenHash           String               @unique @map("token_hash") @db.VarChar(64)
  ipAddress           String?              @map("ip_address") @db.VarChar(45)
  userAgent           String?              @map("user_agent") @db.VarChar(512)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  expiresAt           DateTime             @map("expires_at") @db.Timestamptz
  lastActivityAt      DateTime             @default(now()) @map("last_activity_at") @db.Timestamptz
  revokedAt           DateTime?            @map("revoked_at") @db.Timestamptz

  // Relations
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([tokenHash, revokedAt, expiresAt], name: "ix_user_sessions_lookup")
  @@map("user_sessions")
}

model EmailVerificationToken {
  id                  String               @id @default(uuid()) @db.Uuid
  userId              String               @map("user_id") @db.Uuid
  tokenHash           String               @unique @map("token_hash") @db.VarChar(64)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  expiresAt           DateTime             @map("expires_at") @db.Timestamptz
  consumedAt          DateTime?            @map("consumed_at") @db.Timestamptz

  // Relations
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([tokenHash, consumedAt, expiresAt], name: "ix_email_verification_tokens_lookup")
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id                  String               @id @default(uuid()) @db.Uuid
  userId              String               @map("user_id") @db.Uuid
  tokenHash           String               @unique @map("token_hash") @db.VarChar(64)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  expiresAt           DateTime             @map("expires_at") @db.Timestamptz
  consumedAt          DateTime?            @map("consumed_at") @db.Timestamptz

  // Relations
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([tokenHash, consumedAt, expiresAt], name: "ix_password_reset_tokens_lookup")
  @@map("password_reset_tokens")
}

model StaffInvitation {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @db.VarChar(255)
  roleId              String               @map("role_id") @db.Uuid
  universityId        String               @map("university_id") @db.Uuid
  institutionId       String?              @map("institution_id") @db.Uuid
  departmentId        String?              @map("department_id") @db.Uuid
  tokenHash           String               @unique @map("token_hash") @db.VarChar(255)
  invitedByUserId     String               @map("invited_by_user_id") @db.Uuid
  status              InvitationStatus     @default(INVITED)
  expiresAt           DateTime             @map("expires_at") @db.Timestamptz
  consumedAt          DateTime?            @map("consumed_at") @db.Timestamptz
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  role                Role                 @relation(fields: [roleId], references: [id], onDelete: Cascade)
  university          University           @relation(fields: [universityId], references: [id], onDelete: Cascade)
  institution         Institution?         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  department          Department?          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  invitedByUser       User                 @relation("StaffInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([roleId])
  @@index([universityId])
  @@index([institutionId])
  @@index([departmentId])
  @@index([tokenHash])
  @@index([invitedByUserId])
  @@index([status])
  @@map("staff_invitations")
}

model DomainRoleMapping {
  id                  String               @id @default(uuid()) @db.Uuid
  domainPattern       String               @map("domain_pattern") @db.VarChar(255)
  identityType        String?              @map("identity_type") @db.VarChar(64)
  priority            Int                  @default(100)
  roleId              String               @map("role_id") @db.Uuid
  universityId        String?              @map("university_id") @db.Uuid
  institutionId       String?              @map("institution_id") @db.Uuid
  departmentId        String?              @map("department_id") @db.Uuid
  isActive            Boolean              @default(true) @map("is_active")
  description         String?              @db.VarChar(255)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  role                Role                 @relation(fields: [roleId], references: [id], onDelete: Cascade)
  university          University?          @relation(fields: [universityId], references: [id], onDelete: Cascade)
  institution         Institution?         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  department          Department?          @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([domainPattern])
  @@index([identityType], name: "ix_domain_role_mappings_identity_type")
  @@index([priority], name: "ix_domain_role_mappings_priority")
  @@index([roleId], name: "ix_domain_role_mappings_role_id")
  @@index([universityId], name: "ix_domain_role_mappings_university_id")
  @@index([institutionId], name: "ix_domain_role_mappings_institution_id")
  @@index([departmentId], name: "ix_domain_role_mappings_department_id")
  @@index([isActive], name: "ix_domain_role_mappings_is_active")
  @@index([domainPattern, isActive], name: "ix_domain_pattern_active")
  @@map("domain_role_mappings")
}


// ==============================================================================
// 4. ACADEMIC DOMAIN: SUBJECTS, UNITS, TOPICS & QUESTION BANKS
// ==============================================================================

model Subject {
  id                  String               @id @default(uuid()) @db.Uuid
  departmentId        String               @map("department_id") @db.Uuid
  programId           String?              @map("program_id") @db.Uuid
  semesterId          String?              @map("semester_id") @db.Uuid
  code                String               @db.VarChar(64)
  name                String               @db.VarChar(255)
  credits             Int                  @default(3)
  language            String               @default("English") @db.VarChar(64)
  status              OrganizationStatus   @default(active)
  description         String?              @db.VarChar(1024)
  syllabusVersion     String?              @map("syllabus_version") @db.VarChar(64)
  category            String?              @db.VarChar(64)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  department          Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  program             Program?             @relation(fields: [programId], references: [id], onDelete: SetNull)
  semester            Semester?            @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  units               Unit[]
  topics              Topic[]
  questionBanks       QuestionBank[]
  questions           Question[]
  questionPapers      QuestionPaper[]

  @@unique([departmentId, code], name: "uq_subject_dept_code")
  @@index([departmentId])
  @@index([programId])
  @@index([semesterId])
  @@map("academic_subjects")
}

model Unit {
  id                  String               @id @default(uuid()) @db.Uuid
  subjectId           String               @map("subject_id") @db.Uuid
  number              Int
  name                String               @db.VarChar(255)
  weightagePercent    Float?               @map("weightage_percent")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  subject             Subject              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics              Topic[]
  questions           Question[]

  @@unique([subjectId, number], name: "uq_unit_subject_number")
  @@index([subjectId])
  @@map("academic_units")
}

model Topic {
  id                  String               @id @default(uuid()) @db.Uuid
  unitId              String               @map("unit_id") @db.Uuid
  subjectId           String               @map("subject_id") @db.Uuid
  name                String               @db.VarChar(255)
  description         String?              @db.VarChar(1024)
  status              OrganizationStatus   @default(active)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  unit                Unit                 @relation(fields: [unitId], references: [id], onDelete: Cascade)
  subject             Subject              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions           Question[]

  @@index([unitId])
  @@index([subjectId])
  @@map("academic_topics")
}

model QuestionBank {
  id                  String               @id @default(uuid()) @db.Uuid
  subjectId           String               @map("subject_id") @db.Uuid
  name                String               @db.VarChar(255)
  description         String?              @db.VarChar(1024)
  isArchived          Boolean              @default(false) @map("is_archived")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  subject             Subject              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions           Question[]

  @@index([subjectId])
  @@map("question_banks")
}

// ==============================================================================
// 5. QUESTIONS & VERSION HISTORY
// ==============================================================================

model Question {
  id                  String               @id @default(uuid()) @db.Uuid
  universityId        String               @map("university_id") @db.Uuid
  institutionId       String               @map("institution_id") @db.Uuid
  departmentId        String               @map("department_id") @db.Uuid
  subjectId           String               @map("subject_id") @db.Uuid
  unitId              String?              @map("unit_id") @db.Uuid
  topicId             String?              @map("topic_id") @db.Uuid
  questionBankId      String?              @map("question_bank_id") @db.Uuid

  type                QuestionType         @default(SHORT_ANSWER)
  difficulty          DifficultyLevel      @default(MEDIUM)
  bloomLevel          BloomLevel?          @map("bloom_level")
  status              QuestionStatus       @default(DRAFT)
  language            String               @default("English") @db.VarChar(64)
  marks               Float                @default(5.0)

  text                String               @db.Text
  answer              String?              @db.Text
  explanation         String?              @db.Text
  answerKey           String?              @map("answer_key") @db.Text
  options             Json?                // Array of MCQ options [{key: 'A', text: '...'}, ...]
  correctAnswer       String?              @map("correct_answer") @db.VarChar(16)
  tags                String[]             @default([])
  isPublic            Boolean              @default(false) @map("is_public")
  version             Int                  @default(1)

  createdById         String               @map("created_by_id") @db.Uuid
  approvedById        String?              @map("approved_by_id") @db.Uuid
  approvedAt          DateTime?            @map("approved_at") @db.Timestamptz
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  university          University           @relation(fields: [universityId], references: [id], onDelete: Cascade)
  institution         Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  department          Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  subject             Subject              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  unit                Unit?                @relation(fields: [unitId], references: [id], onDelete: SetNull)
  topic               Topic?               @relation(fields: [topicId], references: [id], onDelete: SetNull)
  questionBank        QuestionBank?        @relation(fields: [questionBankId], references: [id], onDelete: SetNull)
  createdBy           User                 @relation("QuestionCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  approvedBy          User?                @relation("QuestionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  versions            QuestionVersion[]
  paperQuestions      PaperQuestion[]

  @@index([universityId])
  @@index([institutionId])
  @@index([departmentId])
  @@index([subjectId])
  @@index([unitId])
  @@index([topicId])
  @@index([type])
  @@index([difficulty])
  @@index([status])
  @@map("questions")
}

model QuestionVersion {
  id                  String               @id @default(uuid()) @db.Uuid
  questionId          String               @map("question_id") @db.Uuid
  version             Int
  text                String               @db.Text
  marks               Float
  difficulty          DifficultyLevel
  status              QuestionStatus
  answer              String?              @db.Text
  explanation         String?              @db.Text
  options             Json?
  correctAnswer       String?              @map("correct_answer") @db.VarChar(16)
  comments            String?              @db.Text
  editedById          String               @map("edited_by_id") @db.Uuid
  editedAt            DateTime             @default(now()) @map("edited_at") @db.Timestamptz

  // Relations
  question            Question             @relation(fields: [questionId], references: [id], onDelete: Cascade)
  editedBy            User                 @relation("QuestionVersionEditedBy", fields: [editedById], references: [id], onDelete: Cascade)

  @@unique([questionId, version], name: "uq_question_version")
  @@index([questionId])
  @@index([editedById])
  @@map("question_versions")
}

// ==============================================================================
// 6. QUESTION PAPERS, SECTIONS, BLUEPRINTS & WORKFLOW
// ==============================================================================

model Exam {
  id                  String               @id @default(uuid()) @db.Uuid
  universityId        String               @map("university_id") @db.Uuid
  institutionId       String               @map("institution_id") @db.Uuid
  departmentId        String               @map("department_id") @db.Uuid
  code                String               @db.VarChar(64)
  name                String               @db.VarChar(255)
  academicYear        String               @map("academic_year") @db.VarChar(32)
  semester            String?              @db.VarChar(32)
  startDate           DateTime?            @map("start_date") @db.Timestamptz
  endDate             DateTime?            @map("end_date") @db.Timestamptz
  status              ExamStatus           @default(PLANNED)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  university          University           @relation(fields: [universityId], references: [id], onDelete: Cascade)
  institution         Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  department          Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  questionPapers      QuestionPaper[]

  @@unique([departmentId, code, academicYear], name: "uq_exam_dept_code_year")
  @@index([universityId])
  @@index([institutionId])
  @@index([departmentId])
  @@index([status])
  @@map("examinations")
}

model QuestionPaperTemplate {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String               @db.VarChar(255)
  description         String?              @db.VarChar(1024)
  totalMarks          Float                @map("total_marks")
  durationMinutes     Int                  @map("duration_minutes")
  blueprint           Json                 // Sections, marks per question, options rules
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  questionPapers      QuestionPaper[]

  @@map("question_paper_templates")
}

model QuestionPaper {
  id                  String               @id @default(uuid()) @db.Uuid
  universityId        String               @map("university_id") @db.Uuid
  institutionId       String               @map("institution_id") @db.Uuid
  departmentId        String               @map("department_id") @db.Uuid
  subjectId           String               @map("subject_id") @db.Uuid
  programId           String?              @map("program_id") @db.Uuid
  semesterId          String?              @map("semester_id") @db.Uuid
  examId              String?              @map("exam_id") @db.Uuid
  templateId          String?              @map("template_id") @db.Uuid

  title               String               @db.VarChar(255)
  academicYear        String               @map("academic_year") @db.VarChar(32)
  setLetter           String               @default("A") @map("set_letter") @db.VarChar(8)
  language            String               @default("English") @db.VarChar(64)
  durationMinutes     Int                  @default(180) @map("duration_minutes")
  totalMarks          Float                @map("total_marks")
  instructions        String?              @db.Text
  remarks             String?              @db.Text

  status              PaperStatus          @default(DRAFT)
  version             Int                  @default(1)

  createdById         String               @map("created_by_id") @db.Uuid
  reviewerId          String?              @map("reviewer_id") @db.Uuid
  qualityControllerId String?              @map("quality_controller_id") @db.Uuid
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  university          University           @relation(fields: [universityId], references: [id], onDelete: Cascade)
  institution         Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  department          Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  subject             Subject              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  program             Program?             @relation(fields: [programId], references: [id], onDelete: SetNull)
  semester            Semester?            @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  exam                Exam?                @relation(fields: [examId], references: [id], onDelete: SetNull)
  template            QuestionPaperTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy           User                 @relation("PaperCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  reviewer            User?                @relation("PaperReviewedBy", fields: [reviewerId], references: [id], onDelete: SetNull)
  qualityController   User?                @relation("PaperQualityReviewedBy", fields: [qualityControllerId], references: [id], onDelete: SetNull)
  sections            PaperSection[]
  timeline            PaperWorkflowTimeline[]

  @@index([universityId])
  @@index([institutionId])
  @@index([departmentId])
  @@index([subjectId])
  @@index([examId])
  @@index([status])
  @@map("question_papers")
}

model PaperSection {
  id                  String               @id @default(uuid()) @db.Uuid
  paperId             String               @map("paper_id") @db.Uuid
  orderIndex          Int                  @default(1) @map("order_index")
  title               String               @db.VarChar(255)
  instructions        String?              @db.Text
  marksPerQuestion    Float                @map("marks_per_question")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  paper               QuestionPaper        @relation(fields: [paperId], references: [id], onDelete: Cascade)
  questions           PaperQuestion[]

  @@index([paperId])
  @@map("paper_sections")
}

model PaperQuestion {
  id                  String               @id @default(uuid()) @db.Uuid
  sectionId           String               @map("section_id") @db.Uuid
  questionId          String               @map("question_id") @db.Uuid
  questionVersion     Int                  @default(1) @map("question_version")
  orderIndex          Int                  @default(1) @map("order_index")
  marks               Float
  snapshotText        String               @map("snapshot_text") @db.Text
  snapshotOptions     Json?                @map("snapshot_options")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  section             PaperSection         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  question            Question             @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@index([questionId])
  @@map("paper_questions")
}

model PaperWorkflowTimeline {
  id                  String               @id @default(uuid()) @db.Uuid
  paperId             String               @map("paper_id") @db.Uuid
  status              PaperStatus
  actorId             String               @map("actor_id") @db.Uuid
  comment             String?              @db.Text
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  paper               QuestionPaper        @relation(fields: [paperId], references: [id], onDelete: Cascade)
  actor               User                 @relation("PaperTimelineActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([paperId])
  @@index([actorId])
  @@map("paper_workflow_timeline")
}

// ==============================================================================
// 7. AUDIT LOGGING & SYSTEM AUDIT
// ==============================================================================

model AuthenticationAuditEvent {
  id                  String               @id @default(uuid()) @db.Uuid
  eventType           String               @map("event_type") @db.VarChar(64)
  userId              String?              @map("user_id") @db.Uuid
  timestamp           DateTime             @default(now()) @db.Timestamptz
  ipAddress           String?              @map("ip_address") @db.VarChar(45)
  userAgent           String?              @map("user_agent") @db.VarChar(512)
  requestId           String?              @map("request_id") @db.VarChar(64)
  details             String?              @db.VarChar(1024)

  // Relations
  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([timestamp])
  @@index([eventType])
  @@index([userId, timestamp], name: "ix_auth_audit_events_user_time")
  @@map("authentication_audit_events")
}

model SystemAuditLog {
  id                  String               @id @default(uuid()) @db.Uuid
  action              String               @db.VarChar(128)
  actorId             String?              @map("actor_id") @db.Uuid
  resource            String               @db.VarChar(128)
  resourceId          String?              @map("resource_id") @db.VarChar(128)
  severity            String               @default("INFO") @db.VarChar(32)
  ipAddress           String?              @map("ip_address") @db.VarChar(45)
  description         String?              @db.Text
  occurredAt          DateTime             @default(now()) @map("occurred_at") @db.Timestamptz

  // Relations
  actor               User?                @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([resource])
  @@index([occurredAt])
  @@map("system_audit_logs")
}
