# ==============================================================================
# Question Paper Management System (QPMS) — Root Environment Template
# ==============================================================================
# Copy this file to .env before starting compose services:
#   cp .env.example .env
#
# Dedicated application configurations are scoped in:
#   - frontend/.env.example -> frontend/.env.local
#   - backend/.env.example  -> backend/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Local Infrastructure (compose.yaml)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=qpms_dev
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Optional Full-Stack Container Profile Bindings
# ------------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
ALLOWED_ORIGINS=["http://localhost:3000"]
